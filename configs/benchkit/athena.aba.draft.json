  "search": {
    "kind": "nb_tree",
    "input": {
      "parallel": 1,
      "num_designs": 3,
      "num_revisions": 1,
      "max_evaluations": 3,
      "early_stopping": 1
    }
  },
  "resources": {
    "run": {
      "cpu_max_cores": 2,
      "memory_max_gb": 6,
      "disk_free_floor_gb": 4
    },
    "work_unit": {
      "cpu_max_cores": 2,
      "memory_max_gb": 4
    },
    "sandbox": {
      "enable": true
    },
    "cuda_visible_devices": []
