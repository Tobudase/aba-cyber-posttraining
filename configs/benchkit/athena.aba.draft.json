{
  "run": {
    "task_name": "benchkit-athena",
    "data_root": "/workspace/benchkit-athena/task",
    "playground_root": "/workspace/benchkit-athena/playground",
    "budget": {
      "wall_clock_minutes": 180,
      "cost_usd": 5,
      "per_agent_cost_cap_usd": 2,
      "reminder_interval_divisor": 1
    }
  },
  "llm": {
    "default": {
      "model": "qwen3-small",
      "max_thinking_tokens": 0
    },
    "retry_ceiling_s": 60,
    "system_instructions": {
      "setup": "Use the frozen benchmark contract. Keep external dev private. Never fetch or expose official test. Do not alter scorer, prompts or inference policy. Validate actual baseline through the private evaluator.",
      "designer": "Propose at most three bounded SFT configurations within task-contract limits. Use only supplied train data initially. No test-driven selection, no invented results. Record failed candidates and all costs.",
      "worker": "Run the supplied training runner through the controlled GPU submission interface. Read train only. Preserve model revision, labels and native tokenizer. Deliver actual adapter, result.json and exact executed config. No fake checkpoints or model/API substitution.",
      "finalizer": "Copy the selected real adapter, receipt and config without retraining. Do not read test, reconstruct metrics or write an unsupported paper."
    }
  },
  "work_units": [
    {
      "kind": "llm_agent",
      "name": "aggregator",
      "budget": {
        "kind": "fixed",
        "minutes": 4
      },
      "retry": 0
    },
    {
      "kind": "llm_agent",
      "name": "coder",
      "budget": {
        "kind": "fixed",
        "minutes": 4
      },
      "retry": 0
    },
